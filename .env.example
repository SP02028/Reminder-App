# Copy this file to .env and fill in the GroupMe bot IDs for each ensemble you
# want to actually message. Create one bot per group at https://dev.groupme.com/bots
# (each bot posts into exactly one group). Leave a line blank/unset and that
# ensemble's reminders fall back to a local stub (printed + recorded, not sent).

GROUPME_BOT_ID_OCTAVIATION_WHITE=
GROUPME_BOT_ID_OCTAVIATION_GREEN=
GROUPME_BOT_ID_OCTAVIATION_GOLD=
GROUPME_BOT_ID_SELECT=
GROUPME_BOT_ID_BELLE_VOCI=
GROUPME_BOT_ID_AVIATOR_CHORALE=
GROUPME_BOT_ID_COPILOTS=
GROUPME_BOT_ID_BOOSTERS=
